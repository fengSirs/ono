{
  "name": "ono-finclip",
  "version": "1.0.1",
  "private": true,
  "description": "ONO native FinClip mini-program and independent Node/SQLite backend",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm run check && npm test",
    "config:local": "node scripts/use-config.mjs local",
    "config:prod": "node scripts/use-config.mjs prod",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
