NODE_ENV=production
HOST=127.0.0.1
PORT=4390
ALLOW_DEV_GUESTS=false
ONO_DB=/var/lib/ono-finclip/ono.sqlite
PUBLIC_BASE_URL=https://ono.phizminiapp.com
FINCLIP_APP_ID=6af733830efc7c0001051c6a
# pending serves health, configuration and assets while all login/game/reward operations stay closed.
AUTH_MODE=pending
# After implementing the real Phiz identity exchange, set AUTH_MODE=finclip and configure:
# AUTH_EXCHANGE_URL=https://your-identity-service/finclip/exchange
# AUTH_EXCHANGE_TOKEN=server-side-secret
TRUST_LOOPBACK_PROXY=true
