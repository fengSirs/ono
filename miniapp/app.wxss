page {
  background: #faf6e8;
  color: #163e32;
  font-family:
    system-ui,
    -apple-system,
    sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}
view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
button {
  margin: 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  min-height: 92rpx;
  padding: 22rpx 28rpx;
  border-radius: 22rpx;
  background: #1d624b;
  color: #fff;
  white-space: normal;
  word-break: break-word;
}
button::after {
  border: none;
}
button[disabled] {
  opacity: 0.45;
  color: #fff;
  background: #547568;
}
.secondary {
  background: #e9ecd9;
  color: #204a38;
}
.gold {
  background: #f3d88e;
  color: #664919;
}
.danger {
  background: #a73643;
}
.small {
  min-height: 72rpx;
  padding: 15rpx 20rpx;
  font-size: 26rpx;
}
input,
textarea {
  background: #fff;
  border: 2rpx solid #dbdece;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 30rpx;
  width: 100%;
  color: #153e31;
}
input {
  height: 90rpx;
}
textarea {
  height: 200rpx;
}
image {
  max-width: 100%;
}
.screen {
  padding: 28rpx 28rpx 56rpx;
  max-width: 1200rpx;
  margin: auto;
}
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}
.wordmark {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
}
.languages {
  padding: 12rpx 20rpx;
  background: #ecebdc;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.panel {
  background: #fffef7;
  border: 2rpx solid #e4dfca;
  border-radius: 30rpx;
  padding: 30rpx;
  margin: 24rpx 0;
  box-shadow: 0 8rpx 24rpx #153e3108;
}
.title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  margin-bottom: 20rpx;
}
.subtitle {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 14rpx;
}
.muted {
  color: #717968;
  font-size: 27rpx;
}
.row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-wrap: wrap;
}
.between {
  justify-content: space-between;
}
.grow {
  flex: 1;
  min-width: 0;
}
.stack > view,
.stack > button,
.stack > input,
.stack > textarea {
  margin-top: 18rpx;
}
.actions {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.actions > button {
  flex: 1;
  min-width: 220rpx;
}
.error {
  color: #a12f3f;
  background: #f8e7e2;
  padding: 20rpx;
  border-radius: 16rpx;
  margin: 18rpx 0;
  font-size: 27rpx;
  word-break: break-word;
}
.pill {
  padding: 8rpx 18rpx;
  border-radius: 40rpx;
  background: #e7eddd;
  font-size: 25rpx;
}
.code {
  font-size: 70rpx;
  letter-spacing: 8rpx;
  font-weight: 900;
  line-height: 1.3;
}
.field {
  margin: 22rpx 0;
}
.field-label {
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}
.choose {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.choice {
  background: #ecefdc;
  color: #284c3d;
  min-width: 90rpx;
  min-height: 76rpx;
  padding: 16rpx 24rpx;
}
.choice.active {
  background: #1e634c;
  color: white;
}
.full {
  width: 100%;
}
.divider {
  height: 2rpx;
  background: #e7e2d0;
  margin: 24rpx 0;
}
.section-link {
  font-size: 27rpx;
  color: #1c624d;
  padding: 20rpx 0;
}
.notice {
  background: #f5e9c8;
  padding: 24rpx;
  border-radius: 20rpx;
  margin: 20rpx 0;
  font-size: 27rpx;
}
.avatar {
  border-radius: 50%;
  background: #dce9cf;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 32rpx;
}
.player {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #eae7da;
}
.bottom-space {
  height: 90rpx;
}
.floating-pet {
  position: fixed;
  right: 24rpx;
  bottom: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 124rpx;
  height: 124rpx;
  border-radius: 50%;
  background: #f2d485;
  border: 5rpx solid white;
  box-shadow: 0 8rpx 25rpx #102a3940;
  padding: 12rpx;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
}
.floating-pet image {
  width: 100%;
  height: 100%;
}
.tick {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  font-size: 26rpx;
  margin: 20rpx 0;
}
.tick checkbox {
  transform: scale(0.85);
  flex: none;
}
.link {
  color: #24674f;
  text-decoration: underline;
}
.pad-top {
  margin-top: 24rpx;
}
.metric {
  font-size: 42rpx;
  font-weight: 800;
}
.center {
  text-align: center;
}
.progress {
  height: 22rpx;
  border-radius: 20rpx;
  background: #e2e7d7;
  overflow: hidden;
  margin: 18rpx 0;
}
.progress-fill {
  height: 100%;
  border-radius: 20rpx;
  background: #b94548;
}
.help {
  font-size: 25rpx;
  color: #747a68;
  margin: 14rpx 0;
}
.nowrap {
  white-space: nowrap;
}

.brand-logo {
  width: 212rpx;
  height: 66rpx;
  flex: none;
}
page { background:#fff9ee; background-image:radial-gradient(at 5% 5%,#efe1bf54,transparent 40%),radial-gradient(at 95% 55%,#f4dfd054,transparent 45%); color:#344a3a; }
.screen { padding:0 32rpx 64rpx; }
.header,.compact-header { background:#fffdf6; border-top:8rpx solid #235c46; border-image:repeating-linear-gradient(90deg,#235c46 0 72rpx,#cfab63 72rpx 81rpx,#a43742 81rpx 153rpx,#cfab63 153rpx 162rpx) 1; border-bottom:2rpx solid #e3d4af; margin:0 -32rpx 32rpx; padding:22rpx 32rpx; min-height:124rpx; }
.panel { background:#fffef8; border:2rpx solid #e2dfcf; border-radius:28rpx; padding:32rpx; box-shadow:0 4rpx 16rpx #2a492b08; }
button { background:#235a44; color:#fff8e4; border-radius:18rpx; }
.secondary { background:#eef1df; color:#4a7151; border:2rpx solid #cdd8b6; }
.danger { background:#a43742; color:#fff8e4; }
.help,.muted { color:#6d7465; line-height:1.6; }
.notice { background:#f0f2e5; color:#52694e; border:2rpx solid #dce0cf; border-radius:18rpx; }
.code { background:#f0f5e5; border:2rpx dashed #abc18b; border-radius:20rpx; text-align:center; padding:16rpx; color:#235a44; letter-spacing:7rpx; }
.sheet-mask { position:fixed; inset:0; z-index:101; display:flex; align-items:center; justify-content:center; background:#17382e82; padding:28rpx; }
.sheet { width:100%; max-height:84vh; max-width:800rpx; padding:38rpx; box-sizing:border-box; background:#fffdf4; border-radius:28rpx; box-shadow:0 20rpx 80rpx #12372f24; }
.dismiss { background:transparent; color:#4a654f; min-height:72rpx; padding:4rpx 16rpx; font-size:44rpx; }
