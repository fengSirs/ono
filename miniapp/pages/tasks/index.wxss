.proof-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.proof {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}
.proof image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}
.remove {
  position: absolute;
  right: 0;
  top: 0;
  background: #ad3546;
  color: white;
  min-height: 50rpx;
  width: 50rpx;
  font-size: 30rpx;
  padding: 4rpx;
  line-height: 42rpx;
  border-radius: 50%;
}
.mission { background:#f9f7ed; border-color:#e6deca; }
.mission-heading { display:flex; align-items:center; gap:18rpx; }
.mission-heading .subtitle { margin:0; }
.mission-icon { width:62rpx; height:62rpx; line-height:62rpx; background:#e5ecd5; color:#65794d; border-radius:16rpx; text-align:center; font-weight:700; }
