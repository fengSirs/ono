<view class="screen lobby">
  <view class="header"><image class="brand-logo" src="/assets/brand/ono-logo.png" mode="aspectFit" aria-label="ONO!"/><view class="profile-tools"><picker range="{{languages}}" bindchange="changeLang"><view class="language">{{lang === 'pt' ? 'PT-BR' : lang === 'en' ? 'EN' : '中文'}} ﹀</view></picker><button class="profile" data-modal="name" bindtap="showModal"><text class="avatar">{{name[0] || '+'}}</text><text class="profile-name">{{name || t.nickname}}</text> ✎</button></view></view>
  <view wx:if="{{error && !modal}}" class="error">{{error}}</view><button wx:if="{{savedRoom}}" class="gold full" bindtap="resume">{{t.resume}}</button>
  <view class="panel play-hub"><view class="hub-heading"><view class="title">{{t.playHubTitle}}</view><image class="people-icon" src="/assets/brand/players.svg"/></view><view class="muted">{{t.playHubHint}}</view>
    <view class="match-options"><text>{{t.matchSizeTitle}}</text><picker range="{{sizeLabels}}" value="{{size - 2}}" bindchange="matchSize"><view class="select-box">{{sizeLabels[size - 2]}} ﹀</view></picker></view><view class="help">{{t.matchSizeHint}}</view>
    <button class="online full" bindtap="enter" data-op="match" disabled="{{busy}}"><image src="/assets/brand/globe.svg"/> {{t.matchEntry}} <text class="mode-badge">{{size === 2 ? '1v1' : size}}</text> ↗</button>
    <view class="pair"><button class="secondary" data-modal="create" bindtap="showModal">＋ {{t.roomBtn}}</button><button class="danger" data-modal="join" bindtap="showModal">{{t.joinShort}}</button></view>
    <view class="notice">ⓘ　{{c.onlineNoRewards}}</view><view wx:if="{{quota}}" class="help">{{quota}}</view><view class="help">{{t.roomCost}}</view>
  </view>
  <view class="reward-strip"><text class="star">☆</text><view class="grow"><view class="subtitle">{{c.friendsPointsTitle}}</view><view class="help">{{rewardRule}}</view><view class="chips"><text class="tier" wx:for="{{rewardTiers}}" wx:key="*this">{{item}}</text></view></view></view>
  <block wx:if="{{signedIn}}"><include src="../farm/index.wxml"/></block><view wx:else class="panel egg-intro"><image src="/assets/christmas/turkey-baby.webp" mode="aspectFit"/><view class="title">{{c.eggTitle}}</view><view class="help">{{c.eggIntro}}</view><view class="actions pad-top"><button bindtap="farm">{{c.claimEgg}}</button><button class="secondary" bindtap="leaderboard">{{t.weeklyEntry}}</button></view></view>
  <view class="panel rules-banner"><view class="subtitle">{{t.littleTitle}}</view><view class="help">{{t.littleDesc}}</view><view class="actions pad-top"><button class="secondary" bindtap="leaderboard">{{t.weeklyEntry}}</button><button class="secondary" bindtap="rules">{{t.seeRules}}</button></view></view>
  <button class="turkey-shortcut" bindtap="farm"><image src="/assets/christmas/turkey-baby.webp" mode="aspectFit"/><text>{{c.feedAction}}</text></button>
  <view wx:if="{{modal}}" class="sheet-mask"><scroll-view scroll-y class="sheet"><view class="row between"><text class="title">{{modal === 'name' ? t.nickname : modal === 'create' ? t.roomBtn : t.joinShort}}</text><button class="dismiss" bindtap="closeModal" aria-label="{{t.cancel}}">×</button></view>
    <block wx:if="{{modal === 'name'}}"><input value="{{draftName}}" bindinput="nameInput" maxlength="20" placeholder="{{t.nameHelp}}"/><button class="full pad-top" bindtap="save" disabled="{{busy || draftName.length < 2}}">{{t.saveName}}</button></block>
    <block wx:elif="{{modal === 'create'}}"><view class="field-label">{{t.playerCount}}</view><view class="choose"><button wx:for="{{sizes}}" wx:key="*this" class="choice {{capacity === item ? 'active' : ''}}" data-field="capacity" data-value="{{item}}" bindtap="select">{{item}}</button></view><view class="field-label">{{t.roundCount}}</view><view class="choose"><button wx:for="{{roundOptions}}" wx:key="*this" class="choice {{rounds === item ? 'active' : ''}}" data-field="rounds" data-value="{{item}}" bindtap="select">{{item}}</button></view><button class="full pad-top" data-op="create" bindtap="enter" disabled="{{busy}}">{{t.roomBtn}}</button></block>
    <block wx:else><input class="code-entry" value="{{code}}" bindinput="codeInput" type="number" maxlength="6" placeholder="{{t.roomNumber}}"/><button class="danger full pad-top" bindtap="enter" data-op="join" disabled="{{busy || code.length !== 6}}">{{t.joinShort}}</button></block><view wx:if="{{error}}" class="error">{{error}}</view>
  </scroll-view></view>
</view>
