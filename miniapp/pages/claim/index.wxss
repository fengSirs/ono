.compact-claim { padding-top:20rpx; }
.compact-header { display:flex; align-items:center; gap:24rpx; margin-bottom:16rpx; }
.compact-title { flex:1; min-width:0; font-size:36rpx; font-weight:800; line-height:1.3; }
.claim-card { padding:24rpx; border-radius:24rpx; }
.claim-prize { width:100%; height:220rpx; display:block; }
.claim-rank { font-size:36rpx; font-weight:800; color:#1d624b; margin-top:12rpx; }
.claim-message { font-size:28rpx; margin:12rpx 0 20rpx; line-height:1.5; }
.claim-footnote { font-size:24rpx; color:#526c5b; text-align:center; }
.board-entry { margin-top:24rpx; font-size:26rpx; min-height:80rpx; padding:18rpx; }

.compact-header .small { min-height:88rpx; font-size:28rpx; padding:18rpx 20rpx; }
.compact-claim { padding-top:0; }
.claim-card { background:#fffdf4; border-color:#dfcda6; }
.claim-prize { height:290rpx; border-radius:20rpx; background:linear-gradient(135deg,#f7ecda,#f5eddb); }
.claim-card .full:not(.secondary) { background:#a43742; }
