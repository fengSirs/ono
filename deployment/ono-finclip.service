[Unit]
Description=ONO native FinClip mini-program API
After=network.target
[Service]
Type=simple
User=ono-finclip
Group=ono-finclip
WorkingDirectory=/opt/ono-finclip/current
EnvironmentFile=/etc/ono-finclip.env
ExecStart=/opt/node22/bin/node --max-old-space-size=128 /opt/ono-finclip/current/backend/runtime/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ono-finclip
MemoryMax=256M
[Install]
WantedBy=multi-user.target
